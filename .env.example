# Copiez ce fichier en ".env" et remplissez les vraies valeurs.
# Ne jamais publier le fichier .env réel (mots de passe / clés) sur GitHub.

PORT=4000

# Mot de passe de connexion à l'espace administrateur (vous choisissez)
ADMIN_PASSWORD=changez-moi

# Clé secrète utilisée pour signer les sessions admin (chaîne aléatoire longue)
JWT_SECRET=changez-moi-aussi-une-longue-chaine-aleatoire

# Numéros affichés aux clients
WHATSAPP_NUMBER=224613305410
OM_DISPLAY_NUMBER=626622661

# --- Orange Money Web Payment API (à remplir dès réception des identifiants marchands) ---
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_API_BASE_URL=https://api.orange.com/orange-money-webpay/gn/v1
# URL publique de votre serveur une fois déployé (nécessaire pour les retours de paiement)
PUBLIC_BASE_URL=https://votre-domaine-ou-app.exemple.com
